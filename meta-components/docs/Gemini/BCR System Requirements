#### **2. Database Schema & Payload Specifications**

##### **A. Relational Schema (Supporting Two-Phase Hybrid Persistence)**

```sql
-- 1. Master Entity Registry (Artifacts and Bundle Aggregators)
CREATE TABLE bcr_entities (
    entity_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    urn VARCHAR(512) UNIQUE NOT NULL,
    entity_type VARCHAR(32) NOT NULL,       -- 'ARTIFACT' or 'BUNDLE'
    artifact_category VARCHAR(64),          -- 'SPEC', 'LIFECYCLE', 'WORKFLOW', 'METADATA', 'GENERATED_CODE'
    semver VARCHAR(64) NOT NULL,
    lifecycle_state VARCHAR(32) NOT NULL,    -- 'DRAFT', 'ACTIVE', 'DEPRECATED', 'ROLLBACK_SUPERSEDED', 'ROADMAP_ONLY'
    content_sha256 CHAR(64) NOT NULL,        -- Hash of individual payload or bundle manifest in CAS
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    created_by VARCHAR(128) NOT NULL
);

-- 2. Bundle Membership Mapping (Links Aggregators to Member Artifacts)
CREATE TABLE bcr_bundle_memberships (
    membership_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    bundle_urn VARCHAR(512) NOT NULL REFERENCES bcr_entities(urn) ON DELETE CASCADE,
    member_urn VARCHAR(512) NOT NULL REFERENCES bcr_entities(urn) ON DELETE RESTRICT,
    member_alias VARCHAR(128) NOT NULL,      -- Logical role (e.g., 'primary_spec', 'entity_lifecycle')
    source_origin VARCHAR(32) NOT NULL,      -- 'INLINE_NEW' or 'PRE_EXISTING_REFERENCE'
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (bundle_urn, member_urn)
);

-- 3. Lineage Graph (Input Units -> Output Artifacts)
CREATE TABLE bcr_lineage_edges (
    edge_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    source_urn VARCHAR(512) NOT NULL,
    target_urn VARCHAR(512) NOT NULL,
    edge_type VARCHAR(64) NOT NULL,          -- 'EXTENDS', 'PRODUCED_ARTIFACT', 'DEPENDS_ON'
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX idx_bundle_memberships_bundle ON bcr_bundle_memberships(bundle_urn);
CREATE INDEX idx_lineage_source_target ON bcr_lineage_edges(source_urn, target_urn);

```

