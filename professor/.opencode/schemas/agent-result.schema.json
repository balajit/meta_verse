
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-result.schema.json",
  "title": "Professor Agent Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "agent",
    "status",
    "summary",
    "findings",
    "evidence",
    "limitations",
    "acceptance_criteria_check"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "COMPLETED",
        "PARTIAL",
        "BLOCKED",
        "FAILED"
      ]
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "claim",
          "classification",
          "confidence",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "classification": {
            "enum": [
              "OBSERVED_FACT",
              "SUPPORTED_CONCLUSION",
              "HYPOTHESIS",
              "RECOMMENDATION",
              "UNKNOWN"
            ]
          },
          "confidence": {
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "rationale": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "locator",
          "source_type",
          "supports"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "source_type": {
            "enum": [
              "PRIMARY_SOURCE",
              "SECONDARY_SOURCE",
              "REPOSITORY_OBSERVATION",
              "COMMAND_OUTPUT",
              "USER_PROVIDED",
              "INFERENCE"
            ]
          },
          "version_or_date": {
            "type": "string"
          },
          "supports": {
            "type": "string"
          },
          "limitations": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria_check": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "status",
          "rationale"
        ],
        "properties": {
          "criterion": {
            "type": "string"
          },
          "status": {
            "enum": [
              "MET",
              "PARTIAL",
              "NOT_MET",
              "NOT_VERIFIED"
            ]
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "recommended_next_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
