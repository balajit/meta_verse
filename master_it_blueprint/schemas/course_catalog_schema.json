CourseCatalog schema design 
{ "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://learning-platform.example.com/schemas/course-catalog-domain.json", "title": "Course Catalog Domain Model", "description": "Reusable JSON Schema definitions for courses, course versions, structured learning units, lesson content, and study plan templates.", "$defs": { "Course": { "type": "object", "title": "Course", "description": "Macro-level educational program represented in the course catalog.", "properties": { "id": { "type": "string", "minLength": 1, "description": "Stable identifier for the course." }, "title": { "type": "string", "minLength": 1, "description": "Title of the educational program." }, "description": { "type": "string", "description": "Description of the educational program." }, "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Tags that characterize or categorize the course." }, "targetAudience": { "type": "string", "minLength": 1, "description": "Description of the intended audience for the course." }, "statusFlags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Status-related flags associated with the course. The domain does not establish a closed vocabulary for these flags." }, "pricing": { "$ref": "#/$defs/MonetaryValue", "description": "Price associated with the course." } }, "required": [ "id", "title" ], "additionalProperties": false }, "CourseVersion": { "type": "object", "title": "Course Version / Syllabus", "description": "A structural iteration of a course that preserves a distinct version of its syllabus and learning structure.", "properties": { "id": { "type": "string", "minLength": 1, "description": "Stable identifier for the course version or syllabus." }, "courseId": { "type": "string", "minLength": 1, "description": "Identifier referencing the course to which this version belongs." }, "versionIdentifier": { "type": "string", "minLength": 1, "description": "Identifier assigned to this structural iteration of the course." }, "modules": { "type": "array", "items": { "$ref": "#/$defs/Module" }, "description": "Ordered collection of thematic modules constituting this course version." } }, "required": [ "id", "courseId", "versionIdentifier" ], "additionalProperties": false }, "Module": { "type": "object", "title": "Module / Unit", "description": "A structural subdivision within a course version representing a thematic learning chapter.", "properties": { "id": { "type": "string", "minLength": 1, "description": "Stable identifier for the module or unit." }, "title": { "type": "string", "minLength": 1, "description": "Title of the thematic learning chapter represented by the module." }, "description": { "type": "string", "description": "Description of the thematic learning scope of the module." }, "lessons": { "type": "array", "items": { "$ref": "#/$defs/Lesson" }, "description": "Ordered collection of granular learning units contained within the module." } }, "required": [ "id", "title" ], "additionalProperties": false }, "Lesson": { "type": "object", "title": "Lesson / Content Item", "description": "A granular learning unit containing educational content such as media, reading material, quizzes, or interactive assignments.", "properties": { "id": { "type": "string", "minLength": 1, "description": "Stable identifier for the lesson or content item." }, "title": { "type": "string", "minLength": 1, "description": "Title of the granular learning unit." }, "description": { "type": "string", "description": "Description of the learning unit and its educational purpose." }, "content": { "type": "array", "items": { "$ref": "#/$defs/ContentDescriptor" }, "description": "Ordered collection of heterogeneous educational content contained in the lesson." } }, "required": [ "id", "title" ], "additionalProperties": false }, "ContentDescriptor": { "type": "object", "title": "Content Descriptor", "description": "A domain-neutral representation of educational content whose category may be media, reading material, a quiz, an interactive assignment, or another content form supported by the catalog.", "properties": { "contentType": { "type": "string", "minLength": 1, "description": "Domain-defined category of the educational content." }, "contentReference": { "type": "string", "minLength": 1, "description": "Identifier or reference used to locate or identify the educational content." } }, "required": [ "contentType" ], "additionalProperties": false }, "StudyPlanTemplate": { "type": "object", "title": "Study Plan Template", "description": "A pre-configured study plan defining expected pacing, completion milestones, and the intended progression or scheduling structure for study.", "properties": { "id": { "type": "string", "minLength": 1, "description": "Stable identifier for the study plan template." }, "title": { "type": "string", "minLength": 1, "description": "Name of the study plan template." }, "courseId": { "type": "string", "minLength": 1, "description": "Identifier referencing the course for which the study plan is defined." }, "courseVersionId": { "type": "string", "minLength": 1, "description": "Identifier referencing the course version whose learning structure is addressed by the study plan." }, "pacing": { "$ref": "#/$defs/PacingDefinition", "description": "Expected rate of progression through the study plan." }, "milestones": { "type": "array", "items": { "$ref": "#/$defs/CompletionMilestone" }, "description": "Ordered collection of completion milestones defining expected progression through the study plan." }, "schedule": { "$ref": "#/$defs/StudySchedule", "description": "Study schedule definition associated with the template." } }, "required": [ "id", "title", "pacing", "milestones", "schedule" ], "additionalProperties": false }, "PacingDefinition": { "type": "object", "title": "Pacing Definition", "description": "A representation of the expected rate of study progression.", "properties": { "quantity": { "type": "number", "exclusiveMinimum": 0, "description": "Expected amount of progression represented by the pacing definition." }, "unit": { "type": "string", "minLength": 1, "description": "Unit in which the expected pacing quantity is expressed." } }, "required": [ "quantity", "unit" ], "additionalProperties": false }, "CompletionMilestone": { "type": "object", "title": "Completion Milestone", "description": "A defined point of expected completion or progression within a study plan.", "properties": { "id": { "type": "string", "minLength": 1, "description": "Stable identifier for the milestone." }, "title": { "type": "string", "minLength": 1, "description": "Name of the completion milestone." }, "targetOffsetDays": { "type": "integer", "minimum": 0, "description": "Target number of elapsed days from the study plan start by which the milestone is expected to be reached." }, "targetReference": { "type": "string", "minLength": 1, "description": "Identifier or reference for the learning structure or content associated with the milestone." } }, "required": [ "id", "title" ], "additionalProperties": false }, "StudySchedule": { "type": "object", "title": "Study Schedule", "description": "A schedule representation describing the intended structure or progression of study without imposing a specific calendar, recurrence, or time-of-day model.", "properties": { "description": { "type": "string", "minLength": 1, "description": "Description of the intended study schedule." }, "steps": { "type": "array", "items": { "$ref": "#/$defs/ScheduleStep" }, "description": "Ordered schedule steps representing the progression defined by the study schedule." } }, "required": [ "description" ], "additionalProperties": false }, "ScheduleStep": { "type": "object", "title": "Schedule Step", "description": "A step in the progression defined by a study schedule.", "properties": { "sequence": { "type": "integer", "minimum": 0, "description": "Position of the schedule step within the study schedule." }, "targetOffsetDays": { "type": "integer", "minimum": 0, "description": "Target number of elapsed days from the study plan start associated with the schedule step." }, "targetReference": { "type": "string", "minLength": 1, "description": "Identifier or reference for the learning structure or content associated with the schedule step." } }, "required": [ "sequence" ], "additionalProperties": false }, "MonetaryValue": { "type": "object", "title": "Monetary Value", "description": "A monetary amount represented with explicit currency and integer precision.", "properties": { "amount": { "type": "integer", "description": "Monetary amount expressed in the smallest applicable currency unit." }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "description": "Three-letter ISO 4217 currency code." } }, "required": [ "amount", "currency" ], "additionalProperties": false } } }

