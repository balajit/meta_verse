i{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "manifest-orchestrator",
  "agent": {
    "manifest-orchestrator": {
      "description": "Runs the complete staged manifest generation pipeline.",
      "mode": "primary",
      "model": "github-copilot/claude-sonnet-4.5",
      "steps": 40,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "allow",
        "write": "allow",
        "bash": "allow",
        "task": "allow",
        "todowrite": "allow",
        "todoread": "allow"
      }
    },
    "manifest-schema": {
      "description": "Reverse-engineers manifest.schema.json into a deterministic implementation contract.",
      "mode": "subagent",
      "model": "github-copilot/claude-sonnet-4.5",
      "steps": 12,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "write": "allow",
        "edit": "allow",
        "bash": "allow"
      }
    },
    "manifest-domain": {
      "description": "Extracts the normalized domain model from the source requirements.",
      "mode": "subagent",
      "model": "github-copilot/claude-sonnet-4.5",
      "steps": 16,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "write": "allow",
        "edit": "allow",
        "bash": "allow"
      }
    },
    "manifest-relationships": {
      "description": "Builds the canonical directional relationship and aggregate model.",
      "mode": "subagent",
      "model": "github-copilot/claude-sonnet-4.5",
