      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "write": "allow",
        "edit": "allow",
        "bash": "allow"
      }
    },
    "manifest-workflows": {
      "description": "Models FSMs, workflows, dependencies, guards, and retries.",
      "mode": "subagent",
      "model": "github-copilot/claude-sonnet-4.5",
      "steps": 18,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "write": "allow",
        "edit": "allow",
        "bash": "allow"
      }
    },
    "manifest-policies": {
      "description": "Extracts policies, business rules, authorization, and event semantics.",
