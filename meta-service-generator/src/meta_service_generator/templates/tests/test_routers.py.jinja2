        raise


@pytest.mark.asyncio
async def test_full_{{ model.name | snake_case }}_lifecycle(
    async_client: AsyncClient,
) -> None:
    """Test the complete entity lifecycle: Create -> Get -> Update -> Delete."""
    create_payload = {
{% for field in model.fields %}
{% if not field.is_primary_key %}
        "{{ field.name }}": {% if field.python_type == 'str' %}"lifecycle_{{ field.name }}"{% elif field.python_type == 'int' %}5{% elif field.python_type == 'float' %}49.99{% elif field.python_type == 'bool' %}True{% else %}"lifecycle_value"{% endif %},
{% endif %}
{% endfor %}
    }

    try:
        # 1. Create
        create_resp = await async_client.post(BASE_ENDPOINT, json=create_payload)
        assert create_resp.status_code == 201
        created_data = create_resp.json()
        entity_id = created_data.get("id_") or created_data.get("id")
        assert entity_id is not None

        entity_endpoint = f"{BASE_ENDPOINT}/{entity_id}"

        # 2. Get by ID
        get_resp = await async_client.get(entity_endpoint)
        assert get_resp.status_code == 200
        assert get_resp.json()["id_" if "id_" in created_data else "id"] == entity_id

        # 3. Update (PATCH)
        {% set update_ns = namespace(updated=false) %}
        update_payload = {
{% for field in model.fields %}
{% if not update_ns.updated and not field.is_primary_key and field.python_type == 'str' %}
            "{{ field.name }}": "updated_{{ field.name }}",
{% set update_ns.updated = true %}
{% endif %}
{% endfor %}
        }
        if update_payload:
            patch_resp = await async_client.patch(entity_endpoint, json=update_payload)
            assert patch_resp.status_code == 200

        # 4. Delete
        delete_resp = await async_client.delete(entity_endpoint)
        assert delete_resp.status_code == 204

        # 5. Verify Deletion
        get_after_delete = await async_client.get(entity_endpoint)
        assert get_after_delete.status_code == 404

    except Exception:
        logger.exception("Failed during CRUD lifecycle test for %s", BASE_ENDPOINT)
        raise