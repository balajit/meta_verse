from __future__ import annotations

import logging

import pytest
from httpx import AsyncClient

logger = logging.getLogger(__name__)

BASE_ENDPOINT = {{ ("/" + model.table_name.strip("/")) | python_literal }}


@pytest.mark.asyncio
async def test_list_{{ model.name | snake_case }}(
    async_client: AsyncClient,
) -> None:
    """Test listing entities via GET endpoint."""
    try:
        logger.debug("Sending GET request to %s", BASE_ENDPOINT)
        response = await async_client.get(BASE_ENDPOINT)

        logger.debug(
            "Received response from %s: status_code=%s",
            BASE_ENDPOINT,
            response.status_code,
        )

        assert response.status_code == 200
        assert isinstance(response.json(), list)

    except Exception:
        logger.exception("Failed while testing GET %s", BASE_ENDPOINT)
        raise


@pytest.mark.asyncio
async def test_create_{{ model.name | snake_case }}(
    async_client: AsyncClient,
) -> None:
    """Test creating an entity via POST endpoint."""
    payload = {
{% for field in model.fields %}
{% if not field.is_primary_key %}
        "{{ field.name }}": {% if field.python_type == 'str' %}"test_{{ field.name }}"{% elif field.python_type == 'int' %}10{% elif field.python_type == 'float' %}99.99{% elif field.python_type == 'bool' %}True{% else %}"test_value"{% endif %},
{% endif %}
{% endfor %}
    }

    try:
        logger.debug("Sending POST request to %s with payload: %s", BASE_ENDPOINT, payload)
        response = await async_client.post(BASE_ENDPOINT, json=payload)

        logger.debug(
            "Received response from %s: status_code=%s",
            BASE_ENDPOINT,
            response.status_code,
        )

        assert response.status_code == 201
        data = response.json()
        assert isinstance(data, dict)
        assert "id_" in data or "id" in data

    except Exception:
        logger.exception("Failed while testing POST %s", BASE_ENDPOINT)
        raise


@pytest.mark.asyncio
async def test_get_{{ model.name | snake_case }}_by_id_not_found(
