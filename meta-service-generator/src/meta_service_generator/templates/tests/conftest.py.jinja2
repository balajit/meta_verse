@pytest_asyncio.fixture(autouse=True)
async def setup_database() -> AsyncIterator[None]:
    """Initialize database tables before test execution and drop them upon completion [source: 7]."""
    logger.info("Disposing pre-existing connection pool state for active event loop")
    await engine.dispose()

    logger.info("Creating database tables for test session")
    try:
        async with engine.begin() as conn:
            await conn.run_sync(Base.metadata.drop_all)
            await conn.run_sync(Base.metadata.create_all)
        yield
    except Exception as exc:
        logger.exception("Database table creation failed during test setup: %s", exc)
        raise
    finally:
        logger.info("Dropping database tables post-test session")
        try:
            async with engine.begin() as conn:
                await conn.run_sync(Base.metadata.drop_all)
        except Exception as exc:
            logger.exception("Failed to drop database tables during test teardown: %s", exc)
        finally:
            await engine.dispose()


